  "components": {
    "schemas": {
      "success-envelope": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/json-value"
          },
          "serverNow": {
            "$ref": "#/components/schemas/common/$defs/utc"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "required": [
          "data",
          "requestId",
          "serverNow"
        ],
        "additionalProperties": false
      },
      "error-envelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "VALIDATION_FAILED",
                  "UNSUPPORTED_OPERATION",
                  "INVALID_SOURCE",
                  "AUTH_REQUIRED",
                  "SESSION_EXPIRED",
                  "SESSION_REVOKED",
                  "FORBIDDEN",
                  "RESOURCE_NOT_FOUND",
                  "CSRF_INVALID",
                  "REVISION_CONFLICT",
                  "IDEMPOTENCY_MISMATCH",
                  "DEPENDENCY_EXISTS",
                  "ACCOUNT_LIMIT_REACHED",
                  "RESOURCE_DELETED",
                  "CURSOR_EXPIRED",
                  "RECONCILIATION_REQUIRED",
                  "INPUT_FILE_TOO_LARGE",
                  "ARTIFACT_LIMIT_EXCEEDED",
                  "PAYLOAD_TOO_LARGE",
                  "OTP_INVALID",
                  "OTP_EXPIRED",
                  "OTP_ATTEMPTS_EXCEEDED",
                  "ARTIFACT_NOT_READY",
                  "HASH_MISMATCH",
                  "RATE_LIMITED",
                  "AI_QUOTA_EXCEEDED",
                  "STORAGE_CAPACITY_EXCEEDED",
                  "STORAGE_UNAVAILABLE",
                  "MAIL_UNAVAILABLE",
                  "AI_UNAVAILABLE",
                  "CLIENT_SCHEMA_UNSUPPORTED",
                  "LOCAL_QUOTA_EXCEEDED",
                  "WRITER_FENCE_LOST",
                  "PREVIEW_STALE",
                  "RESOURCE_LIMIT_EXCEEDED",
                  "OFFLINE_RESOURCE_MISSING",
                  "CONSENT_INVALID",
                  "LEDGER_UNAVAILABLE",
                  "UPSTREAM_UNAVAILABLE",
                  "MUTATION_NOT_REQUESTED",
                  "DEPENDENCY_NOT_READY"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "scope": {
                    "enum": [
                      "field",
                      "source",
                      "resource",
                      "account",
                      "project"
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "actualCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "entityIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  },
                  "requiresReconciliation": {
                    "type": "boolean"
                  },
                  "requiresNewSnapshot": {
                    "type": "boolean"
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "serverNow": {
            "$ref": "#/components/schemas/common/$defs/utc"
          }
        },
        "required": [
          "error",
          "requestId",
          "serverNow"
        ],
        "additionalProperties": false
      },
      "ops-live": {
        "type": "object",
        "properties": {
          "live": {
            "const": true
          }
        },
        "required": [
          "live"
        ],
        "additionalProperties": false
      },
      "ops-ready": {
        "type": "object",
        "properties": {
          "ready": {
            "const": true
          },
          "scope": {
            "const": "localDependencyProbe"
          },
          "storageProbe": {
            "const": "directoryAccessOnly"
          },
          "persistentWriteVerified": {
            "const": false
          }
        },
        "required": [
          "ready",
          "scope",
          "storageProbe",
          "persistentWriteVerified"
        ],
        "additionalProperties": false
      },
      "ops-capabilities": {
        "type": "object",
        "properties": {
          "profile": {
            "const": "local-dev"
          },
          "registryVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limits": {
            "type": "object",
            "properties": {
              "profileVersion": {
                "const": "local-dev-v1"
              },
              "inputSourceMaxBytes": {
                "const": 20000000
              },
              "metadataBodyMaxBytes": {
                "const": 1048576
              },
              "chunkMaxBytes": {
                "const": 4194304
              },
              "artifactMaxBytes": {
                "const": 268435456
              },
              "workerMemoryBudgetBytes": {
                "const": 536870912
              },
              "denseMatrixMaxCells": {
                "const": 10000000
              },
              "sparseMaxNnz": {
                "const": 10000000
              },
              "featureMaxCount": {
                "const": 20000
              },
              "outputRowMaxCount": {
                "const": 1000000
              },
              "exactPairwiseMaxPairs": {
                "const": 2000000
              },
              "mutationsPerBatch": {
                "const": 100
              },
              "mutationsPerAtomicGroup": {
                "const": 20
              },
              "perInstanceUploads": {
                "const": 8
              },
              "perProjectWriteTasks": {
                "const": 1
              },
              "stagingGraceMs": {
                "const": 86400000
              },
              "uploadExpiryMs": {
                "const": 3600000
              }
            },
            "required": [
              "profileVersion",
              "inputSourceMaxBytes",
              "metadataBodyMaxBytes",
              "chunkMaxBytes",
              "artifactMaxBytes",
              "workerMemoryBudgetBytes",
              "denseMatrixMaxCells",
              "sparseMaxNnz",
              "featureMaxCount",
              "outputRowMaxCount",
              "exactPairwiseMaxPairs",
              "mutationsPerBatch",
              "mutationsPerAtomicGroup",
              "perInstanceUploads",
              "perProjectWriteTasks",
              "stagingGraceMs",
              "uploadExpiryMs"
            ],
            "additionalProperties": false
          },
          "publicAuthEnabled": {
            "const": false
          },
          "productAdaptersEnabled": {
            "const": false
          }
        },
        "required": [
          "profile",
          "registryVersion",
          "limits",
          "publicAuthEnabled",
          "productAdaptersEnabled"
        ],
        "additionalProperties": false
      },
      "ops-operations": {
        "type": "object",
        "properties": {
          "registryVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "operationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "configVersion": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outputKind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "availability": {
                  "enum": [
                    "available",
                    "unavailable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "operationId",
                "configVersion",
                "outputKind",
                "availability",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "nextOffset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "registryVersion",
          "items",
          "nextOffset"
        ],
        "additionalProperties": false
      },
      "ops-compatibility": {
        "type": "object",
        "properties": {
          "serverGeneration": {
            "$ref": "#/components/schemas/uuid"
          },
          "contractVersions": {
            "const": [
              1
            ]
          },
          "localSchemaVersion": {
            "const": 1
          },
          "limitsProfileVersion": {
            "const": "local-dev-v1"
          },
          "maintenance": {
            "type": "boolean"
          },
          "releaseWindowVerified": {
            "const": false
          },
          "requiresReconciliation": {
            "type": "boolean"
          }
        },
        "required": [
          "serverGeneration",
          "contractVersions",
          "localSchemaVersion",
          "limitsProfileVersion",
          "maintenance",
          "releaseWindowVerified",
          "requiresReconciliation"
        ],
        "additionalProperties": false
      },
      "json-value": {
        "$defs": {
          "jsonValue": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/json-value/$defs/jsonValue"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/json-value/$defs/jsonValue"
                }
              }
            ]
          }
        },
        "$ref": "#/components/schemas/json-value/$defs/jsonValue"
      },
      "common": {
        "$defs": {
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "utc": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "sourceRef": {
            "type": "object",
            "properties": {
              "datasetId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "versionId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "role": {
                "enum": [
                  "primary",
                  "left",
                  "right",
                  "concat"
                ]
              },
              "sourceOrder": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "datasetId",
              "versionId"
            ],
            "additionalProperties": false
          },
          "columnRef": {
            "type": "object",
            "properties": {
              "datasetId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "versionId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "columnId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "datasetId",
              "versionId",
