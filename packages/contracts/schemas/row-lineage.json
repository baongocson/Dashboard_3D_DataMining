{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/row-lineage.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["rowId", "sources"],
  "properties": {
    "rowId": {"$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/uuid"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datasetId", "versionId", "rowId", "role", "sourceOrder"],
        "properties": {
          "datasetId": {"$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/uuid"},
          "versionId": {"$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/uuid"},
          "rowId": {"$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/uuid"},
          "role": {"enum": ["primary", "left", "right", "concat"]},
          "sourceOrder": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
        }
      }
    }
  }
}
