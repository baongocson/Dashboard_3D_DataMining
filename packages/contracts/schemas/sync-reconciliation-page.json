{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/sync-reconciliation-page.json",
  "type": "object",
  "properties": {
    "reconciliationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "serverGeneration": {
      "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
    },
    "snapshotHash": {
      "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
    },
    "requestHash": {
      "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "coverage": {
      "const": "submittedSummaries"
    },
    "completeServerManifest": {
      "const": false
    },
    "requiresUserReview": {
      "const": true
    },
    "mutationsApplied": {
      "const": false
    },
    "offset": {
      "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/revision"
    },
    "totalCount": {
      "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/revision"
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "https://dashboard.invalid/contracts/v1/sync-reconciliation-types.json#/$defs/row"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "manifestBound": {
      "type": "boolean"
    },
    "manifestBindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "https://dashboard.invalid/contracts/v1/sync-reconciliation-types.json#/$defs/boundManifest"
      }
    }
  },
  "required": [
    "reconciliationId",
    "serverGeneration",
    "snapshotHash",
    "requestHash",
    "createdAt",
    "expiresAt",
    "coverage",
    "completeServerManifest",
    "requiresUserReview",
    "mutationsApplied",
    "offset",
    "totalCount",
    "pageSize",
    "rows",
    "nextCursor",
    "complete",
    "manifestBound",
    "manifestBindings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "manifestBound": {
            "const": true
          }
        },
        "required": [
          "manifestBound"
        ]
      },
      "then": {
        "properties": {
          "manifestBindings": {
            "minItems": 1,
            "type": "array"
          }
        }
      },
      "else": {
        "properties": {
          "manifestBindings": {
            "maxItems": 0,
            "type": "array"
          }
        }
      }
    }
  ]
}
