{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/auth-password-reset.json",
  "type": "object",
  "properties": {
    "grant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,256}$"
    },
    "password": {
      "type": "string",
      "minLength": 15,
      "maxLength": 128
    },
    "confirmPassword": {
      "type": "string",
      "minLength": 15,
      "maxLength": 128
    }
  },
  "required": [
    "grant",
    "password",
    "confirmPassword"
  ],
  "additionalProperties": false
}
