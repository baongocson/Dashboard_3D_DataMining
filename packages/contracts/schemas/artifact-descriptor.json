{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/artifact-descriptor.json",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "purpose": {
      "enum": [
        "source",
        "tableManifest",
        "tableChunk",
        "rowLineage",
        "sparse",
        "model",
        "metrics",
        "chartImage",
        "pdf"
      ]
    },
    "formatVersion": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dependencyArtifactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "artifactId",
    "purpose",
    "formatVersion",
    "mediaType",
    "sizeBytes",
    "sha256",
    "projectId",
    "dependencyArtifactIds"
  ],
  "additionalProperties": false
}
