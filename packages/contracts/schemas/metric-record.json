{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/metric-record.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "defined",
        "undefined",
        "notApplicable",
        "notComputed"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evaluationSet": {
      "enum": [
        "train",
        "test",
        "full"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "versionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "role": {
            "enum": [
              "primary",
              "left",
              "right",
              "concat"
            ]
          },
          "sourceOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "datasetId",
          "versionId"
        ],
        "additionalProperties": false
      }
    },
    "sampleInfo": {
      "type": "object",
      "properties": {
        "populationSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "renderCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excludedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "populationSize",
        "renderCount",
        "method"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "value",
    "status",
    "evaluationSet",
    "params",
    "sourceRefs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "defined"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  ]
}
