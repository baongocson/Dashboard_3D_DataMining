{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/preview-request.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ownerId": {
      "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/uuid"
    },
    "projectId": {
      "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/uuid"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sourceRef"
      }
    },
    "sourceArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/uuid"
          },
          "sha256": {
            "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
          }
        },
        "required": [
          "artifactId",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "sourceRowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "config": {
      "$ref": "https://dashboard.invalid/contracts/v1/operation-config.json"
    },
    "contextRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "localGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "enum": [
        "full",
        "sample"
      ]
    },
    "sampleMethod": {
      "enum": [
        "none",
        "head",
        "seededUniform"
      ]
    },
    "sampleSeed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "rowsExamined": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "ownerId",
    "projectId",
    "sourceRefs",
    "sourceArtifacts",
    "sourceRowCount",
    "config",
    "contextRevision",
    "localGeneration",
    "scope",
    "sampleMethod",
    "sampleSeed",
    "rowsExamined"
  ],
  "additionalProperties": false
}
