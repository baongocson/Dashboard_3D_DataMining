{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/storage-types.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "serverGeneration": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "descriptor": {
          "$ref": "https://dashboard.invalid/contracts/v1/artifact-descriptor.json"
        }
      },
      "required": [
        "serverGeneration",
        "descriptor"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "uploadId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "artifactId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "chunkSizeBytes": {
          "const": 4194304
        },
        "expiresAt": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/utc"
        },
        "serverGeneration": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "state": {
          "enum": [
            "declared",
            "uploading",
            "verifying",
            "verified",
            "cancelled"
          ]
        },
        "receivedChunks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
              }
            },
            "required": [
              "index",
              "offset",
              "length",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "uploadId",
        "artifactId",
        "chunkSizeBytes",
        "expiresAt",
        "serverGeneration",
        "state",
        "receivedChunks"
      ],
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "properties": {
        "uploadId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
        },
        "received": {
          "const": true
        }
      },
      "required": [
        "uploadId",
        "index",
        "sha256",
        "received"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "uploadId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "state": {
          "enum": [
            "cancelled",
            "ready"
          ]
        },
        "bytesRetained": {
          "const": true
        }
      },
      "required": [
        "uploadId",
        "state",
        "bytesRetained"
      ],
      "additionalProperties": false
    },
    "cleanupQuery": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cleanupPage": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "retain-only"
        },
        "physicalDeletionEnabled": {
          "const": false
        },
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "artifactId": {
                "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
              },
              "eligibleForFuturePlan": {
                "type": "boolean"
              },
              "protectedReason": {
                "enum": [
                  "reference",
                  "activeLease",
                  "grace",
                  null
                ]
              }
            },
            "required": [
              "artifactId",
              "eligibleForFuturePlan",
              "protectedReason"
            ],
            "additionalProperties": false
          }
        },
        "hasMore": {
          "type": "boolean"
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "physicalDeletionEnabled",
        "entries",
        "hasMore",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  }
}
