{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/auth-csrf.json",
  "type": "object",
  "properties": {
    "csrfToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,256}$"
    },
    "expiresAt": {
      "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/utc"
    }
  },
  "required": [
    "csrfToken",
    "expiresAt"
  ],
  "additionalProperties": false
}
