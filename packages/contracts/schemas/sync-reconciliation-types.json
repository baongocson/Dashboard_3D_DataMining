{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/sync-reconciliation-types.json",
  "$defs": {
    "entity": {
      "type": "object",
      "properties": {
        "projectId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "entityId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "kind": {
          "enum": [
            "project",
            "dataset",
            "version",
            "branch"
          ]
        },
        "revision": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/revision"
        },
        "payloadHash": {
          "anyOf": [
            {
              "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "projectId",
        "entityId",
        "kind",
        "revision",
        "payloadHash"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "projectId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "artifactId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "sha256": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
        },
        "sizeBytes": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/revision"
        }
      },
      "required": [
        "projectId",
        "artifactId",
        "sha256",
        "sizeBytes"
      ],
      "additionalProperties": false
    },
    "pending": {
      "type": "object",
      "properties": {
        "projectId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "mutationId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "entityId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "groupId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "kind": {
          "enum": [
            "project.create",
            "project.rename",
            "dataset.create",
            "dataset.rename",
            "dataset.version.create"
          ]
        },
        "baseRevision": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/revision"
        },
        "payloadHash": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "targetIds": {
          "type": "array",
          "items": {
            "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      },
      "required": [
        "projectId",
        "mutationId",
        "entityId",
        "groupId",
        "kind",
        "baseRevision",
        "payloadHash",
        "artifactIds",
        "targetIds"
      ],
      "additionalProperties": false
    },
    "row": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "entity",
                "artifact"
              ]
            },
            "projectId": {
              "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
            },
            "id": {
              "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
            },
            "comparison": {
              "enum": [
                "same",
                "different",
                "missing",
                "deleted"
              ]
            },
            "serverRevision": {
              "anyOf": [
                {
                  "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/revision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "serverHash": {
              "anyOf": [
                {
                  "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "projectId",
            "id",
            "comparison",
            "serverRevision",
            "serverHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "mutation"
            },
            "projectId": {
              "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
            },
            "id": {
              "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
            },
            "groupId": {
              "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
            },
            "entityId": {
              "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
            },
            "payloadHash": {
              "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
            },
            "action": {
              "enum": [
                "ackProven",
                "blockedDeleted",
                "requiresReconciliation",
                "pending",
                "conflict"
              ]
            },
            "code": {
              "anyOf": [
                {
                  "$ref": "https://dashboard.invalid/contracts/v1/error-envelope.json#/properties/error/properties/code"
                },
                {
                  "type": "null"
                }
              ]
            },
            "receipt": {
              "$ref": "https://dashboard.invalid/contracts/v1/sync-ack.json#/properties/acknowledged/items"
            },
            "proofAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
            }
          },
          "required": [
            "type",
            "projectId",
            "id",
            "groupId",
            "entityId",
            "payloadHash",
            "action",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "manifestBinding": {
      "type": "object",
      "properties": {
        "projectId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "manifestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "snapshotHash": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
        }
      },
      "required": [
        "projectId",
        "manifestId",
        "snapshotHash"
      ],
      "additionalProperties": false
    },
    "boundManifest": {
      "type": "object",
      "properties": {
        "projectId": {
          "$ref": "https://dashboard.invalid/contracts/v1/uuid.json"
        },
        "manifestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "snapshotHash": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
        },
        "sequence": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/revision"
        },
        "metadataRevision": {
          "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/revision"
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "required": [
        "projectId",
        "manifestId",
        "snapshotHash",
        "sequence",
        "metadataRevision",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "https://dashboard.invalid/contracts/v1/sync-reconciliation-types.json#/$defs/row"
}
