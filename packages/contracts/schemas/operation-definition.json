    "configVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "label": {
      "type": "string"
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "inputKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputKind": {
      "enum": [
        "view",
        "version",
        "artifact",
        "config",
        "control"
      ]
    },
    "configSchemaId": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://dashboard.invalid/contracts/v1/json-value.json"
          }
        }
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resourceEstimator": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "previewHandler": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "executor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "cancelMode": {
      "enum": [
        "unavailable",
        "cooperative",
        "terminate",
        "notApplicable"
      ]
    },
    "offlineCapable": {
      "type": "boolean"
    },
    "learnsParameters": {
      "enum": [
        true,
        false,
        "conditional"
      ]
    },
    "createsVersion": {
      "type": "boolean"
    },
    "capability": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unavailable",
            "available"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "fitPolicy": {
          "type": "string",
          "minLength": 1
        },
        "offlinePolicy": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "contracts": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "section",
        "output",
        "fitPolicy",
        "offlinePolicy",
        "gates",
        "implementation",
        "contracts",
        "acceptance"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "configVersion",
    "label",
    "group",
    "inputKinds",
    "outputKind",
    "configSchemaId",
    "defaults",
    "preconditions",
    "resourceEstimator",
    "previewHandler",
    "executor",
    "cancelMode",
    "offlineCapable",
    "learnsParameters",
    "createsVersion",
    "capability",
    "documentation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "capability": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          }
        },
        "required": [
          "capability"
        ]
      },
      "then": {
        "properties": {
          "executor": {
            "type": "string",
            "minLength": 1
          },
          "previewHandler": {
            "type": "string",
            "minLength": 1
          },
          "resourceEstimator": {
            "type": "string",
            "minLength": 1
          },
          "defaults": {
            "type": "object"
          },
          "cancelMode": {
            "enum": [
              "cooperative",
              "terminate",
              "notApplicable"
            ]
          },
          "capability": {
            "properties": {
              "evidenceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "evidenceRefs"
            ],
            "type": "object"
          }
        }
      }
    }
  ]
}
