{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/table-manifest.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "formatVersion": {
      "const": "table-jsonl-v1"
    },
    "schema": {
      "type": "array",
      "items": {
        "$ref": "https://dashboard.invalid/contracts/v1/column.json"
      }
    },
    "columnOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "rowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "$ref": "https://dashboard.invalid/contracts/v1/common.json#/$defs/sha256"
          },
          "rowStart": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rowCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "artifactId",
          "sizeBytes",
          "sha256",
          "rowStart",
          "rowCount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "formatVersion",
    "schema",
    "columnOrder",
    "rowCount",
    "chunks"
  ],
  "additionalProperties": false
}
