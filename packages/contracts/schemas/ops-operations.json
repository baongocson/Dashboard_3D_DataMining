{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.invalid/contracts/v1/ops-operations.json",
  "type": "object",
  "properties": {
    "registryVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "configVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputKind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "availability": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "operationId",
          "configVersion",
          "outputKind",
          "availability",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "nextOffset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "registryVersion",
    "items",
    "nextOffset"
  ],
  "additionalProperties": false
}
